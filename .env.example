# ==========================================
# OMNIDRIVE ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to `.env` in the root folder.
# All variables are shared (symlinked) to the web and worker packages.
# If `.env` doesn't exist, the app reads from `.env` (web) or `.dev.vars` (worker).

# ------------------------------------------
# GENERAL / PORT CONFIGURATION
# ------------------------------------------
# Main ports for web and worker (optional — defaults shown below)
#PORT=8999
WEB_PORT=8999
WORKER_PORT=8888

# Base URLs for the Frontend and Worker
FRONTEND_URL=http://localhost:8999
WORKER_URL=http://localhost:8888

# ------------------------------------------
# WEB CONFIGURATION
# ------------------------------------------
# API base URL for the frontend. Leave EMPTY (recommended) to use same-origin
# /api — Vite proxy (dev) and Pages rewrite (production) handle routing.
# The session cookie is stored on the frontend host and persists after tab close.
# Set this only if you intentionally call the Worker directly (cross-site —
# the cookie may not survive across origins).
VITE_API_URL=

# Canonical public URL of the deployed site (no trailing slash).
# Used for robots.txt, sitemap.xml, llms.txt, and legal pages.
VITE_PUBLIC_URL=http://localhost:8999

# ------------------------------------------
# WORKER / AUTH SECRETS
# ------------------------------------------
# Google OAuth 2.0 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT secret for session authentication
# Generate with: node -e "console.log(crypto.randomUUID().replace(/-/g,''))"
JWT_SECRET=your-random-32-char-jwt-secret-here

# Encryption key for encrypting tokens (e.g., OAuth access tokens)
# Generate with: node -e "console.log(crypto.randomUUID().replace(/-/g,''))"
TOKEN_ENCRYPTION_KEY=your-random-32-char-encryption-key

# Optional: Bootstrap token for first registration.
# If set, the first user registration requires this token instead of being fully open.
# Generate with: node -e "console.log(crypto.randomUUID().replace(/-/g,''))"
# BOOTSTRAP_TOKEN=your-bootstrap-token-here
